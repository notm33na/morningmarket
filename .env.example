# Local tools only (tools/). Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
# The only places model names live. Mirror both into the Sheet Config tab (GEMINI_MODEL, GEMINI_FALLBACK_MODEL).
# Pick a stable free-tier Flash model from ai.google.dev/gemini-api/docs/models (check C7).
GEMINI_MODEL=
# Used by the retry (module 15) when GEMINI_MODEL fails: a stable free-tier Flash-Lite model (check C7).
GEMINI_FALLBACK_MODEL=
# CoinGecko Demo API key (free; header x-cg-demo-api-key)
COINGECKO_API_KEY=
# Your own Gmail; test subscribers use plus-addresses: {{TEST_EMAIL+mm1}} -> <your-name>+mm1@<gmail domain>
TEST_EMAIL=
SITE_URL=https://media-and-software-manger.vercel.app

# Vercel project env vars (set in the Vercel dashboard; listed here for reference only)
# GOOGLE_SA_EMAIL=
# GOOGLE_SA_PRIVATE_KEY=
# MM_SHEET_ID=
# MM_HMAC_SECRET=          # 32+ random bytes, hex
# GMAIL_USER=
# GMAIL_APP_PASSWORD=      # 16-char Google app password (2-Step Verification required)
# SITE_URL=
